# Cebian Telegram Gateway — copy thành .env khi chạy local,
# hoặc điền giá trị tương ứng vào Koyeb Dashboard → Service → Variables.

# Bot token lấy từ @BotFather (format: <bot_id>:<token>)
TELEGRAM_BOT_TOKEN=

# Secret khớp với `secret_token` truyền vào Telegram setWebhook
# (đồng thời là "Webhook secret" trong Cebian Settings)
TELEGRAM_WEBHOOK_SECRET=

# Shared secret extension trình diện ở ?token= khi mở WebSocket
# (đồng thời là "WS auth token" trong Cebian Settings)
WS_AUTH_TOKEN=

# CSV chat id được phép (vd: 965822571). Rỗng = từ chối tất cả (fail-closed)
ALLOWED_CHAT_IDS=

# Cổng HTTP (Koyeb web service mặc định expose 8000)
PORT=8000
